# Copy to backend/.env and fill in. Never commit the real .env or the .pem key.

# Application ID from https://enablebanking.com/cp/applications (also the .pem file name)
ENABLE_BANKING_APP_ID=

# Path to the private key downloaded when registering the application. Keep it outside the repo.
ENABLE_BANKING_KEY_PATH=C:/Users/you/.enablebanking/your-application-id.pem

# Optional: must be one of the redirect URLs registered on the application.
# Defaults to the first registered URL. With http://localhost:<port>/<path> the CLI
# catches the redirect itself; otherwise it asks you to paste the URL you land on.
ENABLE_BANKING_REDIRECT_URL=http://localhost:8765/callback

# Optional: where sessions and downloaded transactions are stored (default backend/data)
FINANCE_DATA_DIR=

# Optional: the people accounts can belong to, comma-separated, e.g. "Alex,Sam". Every account is one
# person's or shared, and the overview can count any of them. Leave empty if everything is shared.
FINANCE_PEOPLE=
