# Backup settings. Copy to deploy/backup.env on the server and fill in. Never commit backup.env.

# A private Cloudflare R2 bucket and an API token limited to it (R2 > Manage API tokens > Object Read & Write, this
# bucket). The backups aren't encrypted: keep the bucket private.
BACKUP_BUCKET=finance-backups
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: ping URLs (e.g. healthchecks.io) so a failed or missed refresh or backup sends you an email.
# The scripts append the exit status (/0 for success).
HEALTHCHECK_REFRESH_URL=
HEALTHCHECK_BACKUP_URL=
# Pinged by the deploy timer every minute (period 1 minute, grace 5 minutes): reports failed deploys, an unhealthy
# app or stopped tunnel, and the timer or server stopping. See "Knowing it's up" in docs/hosting.md.
HEALTHCHECK_DEPLOY_URL=
