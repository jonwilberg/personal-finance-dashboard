# The hosted app's settings. Copy to deploy/app.env on the server and fill in. Never commit app.env.

# Enable Banking application ID (the key file goes in deploy/secrets/enablebanking.pem).
ENABLE_BANKING_APP_ID=

# The callback on the app's public address. Must also be registered on the Enable Banking application.
ENABLE_BANKING_REDIRECT_URL=https://finance.example.com/callback

# Cloudflare Access (Zero Trust > Settings > Custom pages shows the team domain; the Access application's
# Overview shows its "Application Audience (AUD) Tag").
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# Who may use the app, comma-separated. The app checks this itself, on top of the Access policy.
FINANCE_ALLOWED_EMAILS=
